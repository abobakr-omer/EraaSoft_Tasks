            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"New User\",\n  \"email\": \"new.user@bank.com\",\n  \"password\": \"Password@123\",\n  \"phone\": \"0100000000\"\n}"
            },
            "description": "Expected 201, role CUSTOMER"
