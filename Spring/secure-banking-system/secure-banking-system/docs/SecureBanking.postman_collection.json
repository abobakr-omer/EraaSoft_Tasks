            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Evil\",\n  \"email\": \"evil@bank.com\",\n  \"password\": \"Password@123\",\n  \"roles\": [\n    \"ROLE_ADMIN\"\n  ]\n}"
            },
            "description": "Expected 400"
